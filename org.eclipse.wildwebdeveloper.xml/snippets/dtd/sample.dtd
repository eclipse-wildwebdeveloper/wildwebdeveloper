<?xml version="1.0" encoding="UTF-8"?>

<!-- ============================================================ -->
<!-- Parameter entities                                           -->
<!-- ============================================================ -->

<!ENTITY % boolean     "(true | false)">
<!ENTITY % yesno       "(yes | no)">
<!ENTITY % uri.att     "CDATA">
<!ENTITY % common.att
    "id       ID       #IMPLIED
     class    CDATA    #IMPLIED
     lang     NMTOKEN  #IMPLIED">

<!ENTITY % inline.content  "(#PCDATA | span | em | strong | a)*">
<!ENTITY % block.elements  "p | div | section | ul | ol | table">

<!-- ============================================================ -->
<!-- External parameter entity                                    -->
<!-- ============================================================ -->

<!ENTITY % common SYSTEM "common.dtd">
%common;

<!-- ============================================================ -->
<!-- General entities                                             -->
<!-- ============================================================ -->

<!ENTITY copy   "&#169;">
<!ENTITY mdash  "&#8212;">
<!ENTITY ldquo  "&#8220;">
<!ENTITY rdquo  "&#8221;">
<!ENTITY appname "My Application">

<!ENTITY logo SYSTEM "images/logo.png" NDATA png>
<!ENTITY banner PUBLIC "-//Example//IMAGE banner//EN" "banner.gif" NDATA gif>

<!-- ============================================================ -->
<!-- Notation declarations                                        -->
<!-- ============================================================ -->

<!NOTATION png   SYSTEM "image/png">
<!NOTATION gif   SYSTEM "image/gif">
<!NOTATION svg   PUBLIC "-//W3C//DTD SVG 1.1//EN"
                        "http://www.w3.org/Graphics/SVG/1.1/DTD/svg11.dtd">
<!NOTATION pdf   SYSTEM "application/pdf">

<!-- ============================================================ -->
<!-- Processing instruction                                       -->
<!-- ============================================================ -->

<?xml-stylesheet type="text/xsl" href="style.xsl"?>

<!-- ============================================================ -->
<!-- ELEMENT declarations — simple content models                 -->
<!-- ============================================================ -->

<!ELEMENT root   (head, body, footer?)>
<!ELEMENT head   (title, meta*, link*)>
<!ELEMENT title  (#PCDATA)>
<!ELEMENT meta   EMPTY>
<!ELEMENT link   EMPTY>
<!ELEMENT footer ANY>

<!-- ============================================================ -->
<!-- ELEMENT declarations — mixed content                         -->
<!-- ============================================================ -->

<!ELEMENT p      %inline.content;>
<!ELEMENT span   (#PCDATA | em | strong | a | code)*>
<!ELEMENT em     (#PCDATA)>
<!ELEMENT strong (#PCDATA)>
<!ELEMENT code   (#PCDATA)>
<!ELEMENT a      (#PCDATA | span | em)*>

<!-- ============================================================ -->
<!-- ELEMENT declarations — sequences, choices, operators         -->
<!-- ============================================================ -->

<!ELEMENT body   (%block.elements;)+>
<!ELEMENT div    ((%block.elements;)*, p?)>
<!ELEMENT section (title, (p | div | ul | ol | table)+)>
<!ELEMENT ul     (li)+>
<!ELEMENT ol     (li)+>
<!ELEMENT li     %inline.content;>

<!ELEMENT table  (caption?, (thead | tbody | tfoot)*)>
<!ELEMENT caption (#PCDATA)>
<!ELEMENT thead  (tr)+>
<!ELEMENT tbody  (tr)+>
<!ELEMENT tfoot  (tr)+>
<!ELEMENT tr     (th | td)+>
<!ELEMENT th     %inline.content;>
<!ELEMENT td     %inline.content;>

<!-- ============================================================ -->
<!-- ELEMENT declarations — multi-line                            -->
<!-- ============================================================ -->

<!ELEMENT config
    (server,
     database,
     cache?,
     logging+,
     security*)>

<!ELEMENT server   (host, port, timeout?)>
<!ELEMENT database (driver, url, credentials)>
<!ELEMENT cache    (type, size?, ttl?)>
<!ELEMENT logging  (level, appender+)>
<!ELEMENT security (auth, roles?)>

<!-- ============================================================ -->
<!-- ELEMENT using parameter entity reference                     -->
<!-- ============================================================ -->

<!ELEMENT host     (#PCDATA)>
<!ELEMENT port     (#PCDATA)>
<!ELEMENT timeout  (#PCDATA)>
<!ELEMENT driver   (#PCDATA)>
<!ELEMENT url      (#PCDATA)>
<!ELEMENT credentials (username, password)>
<!ELEMENT username (#PCDATA)>
<!ELEMENT password (#PCDATA)>
<!ELEMENT type     (#PCDATA)>
<!ELEMENT size     (#PCDATA)>
<!ELEMENT ttl      (#PCDATA)>
<!ELEMENT level    (#PCDATA)>
<!ELEMENT appender (#PCDATA)>
<!ELEMENT auth     (#PCDATA)>
<!ELEMENT roles    (role+)>
<!ELEMENT role     (#PCDATA)>

<!-- ============================================================ -->
<!-- ATTLIST declarations — all attribute types                   -->
<!-- ============================================================ -->

<!ATTLIST root
    version     CDATA                        #REQUIRED
    lang        NMTOKEN                      "en"
    id          ID                           #IMPLIED>

<!ATTLIST a
    href        %uri.att;                    #REQUIRED
    target      (blank | self | parent | top) "_self"
    rel         NMTOKEN                      #IMPLIED
    %common.att;>

<!ATTLIST meta
    name        NMTOKEN                      #REQUIRED
    content     CDATA                        #REQUIRED
    http-equiv  NMTOKEN                      #IMPLIED>

<!ATTLIST link
    rel         NMTOKEN                      #REQUIRED
    type        CDATA                        #IMPLIED
    href        %uri.att;                    #REQUIRED
    media       CDATA                        #IMPLIED>

<!ATTLIST td
    rowspan     CDATA                        "1"
    colspan     CDATA                        "1"
    align       (left | center | right | justify) #IMPLIED
    valign      (top | middle | bottom | baseline)  #IMPLIED
    %common.att;>

<!-- ATTLIST with NOTATION type -->
<!ATTLIST link
    format      NOTATION (png | gif | svg | pdf) #IMPLIED>

<!-- ATTLIST with ENTITY / ENTITIES / IDREFS types -->
<!ATTLIST div
    background  ENTITY                       #IMPLIED
    images      ENTITIES                     #IMPLIED
    xrefs       IDREFS                       #IMPLIED
    tokens      NMTOKENS                     #IMPLIED
    idref       IDREF                        #IMPLIED
    %common.att;>

<!-- ATTLIST with Nmtoken enum values (digit/dot/hyphen start) -->
<!ATTLIST td
    rowspan-extra  (1 | 2 | 3 | 4)          #IMPLIED
    priority       (0 | 1 | 2 | 3)          #IMPLIED
    step           (0.5 | 1.0 | 1.5)        #IMPLIED
    marker         (-left | -right | none)   #IMPLIED>

<!-- ATTLIST with #FIXED -->
<!ATTLIST section
    xmlns       CDATA     #FIXED "http://www.example.com/ns"
    %common.att;>

<!-- ============================================================ -->
<!-- Qualified / namespaced names (Unicode)                       -->
<!-- ============================================================ -->

<!ELEMENT xhtml:div    %inline.content;>
<!ELEMENT xhtml:span   (#PCDATA)>
<!ELEMENT dc:title     (#PCDATA)>
<!ELEMENT dc:creator   (#PCDATA)>

<!ATTLIST xhtml:div
    xml:lang   NMTOKEN   #IMPLIED
    xml:space  (default | preserve) #IMPLIED>

<!-- ============================================================ -->
<!-- Parameter entity reference in element content               -->
<!-- ============================================================ -->

<!ELEMENT inline %inline.content;>
<!ELEMENT block  (%block.elements; | inline)+>

<!-- ============================================================ -->
<!-- Conditional sections — INCLUDE                               -->
<!-- ============================================================ -->

<![ INCLUDE [
    <!ELEMENT video (source+, track*)>
    <!ELEMENT source EMPTY>
    <!ELEMENT track  EMPTY>
    <!ATTLIST source
        src   %uri.att; #REQUIRED
        type  CDATA     #IMPLIED>
    <!ATTLIST track
        kind  (subtitles | captions | descriptions | chapters | metadata) #IMPLIED
        src   %uri.att; #REQUIRED
        srclang NMTOKEN #IMPLIED>
]]>

<!-- ============================================================ -->
<!-- Conditional sections — IGNORE (with nested IGNORE)           -->
<!-- ============================================================ -->

<![ IGNORE [
    <!ELEMENT deprecated-elem (#PCDATA)>
    <!ATTLIST deprecated-elem
        old-attr CDATA #IMPLIED>

    <!-- nested ignored section -->
    <![ IGNORE [
        <!ELEMENT deeply-ignored ANY>
    ]]>
]]>

<!-- ============================================================ -->
<!-- Parameter entity reference used as % marker                  -->
<!-- ============================================================ -->

<!ENTITY % draft "IGNORE">
<!ENTITY % final "INCLUDE">

<![ %final; [
    <!ELEMENT release-notes (#PCDATA)>
]]>

<![ %draft; [
    <!ELEMENT draft-notes (#PCDATA)>
]]>
